# Database
USER_DATABASE_URL=YOUR_DATABASE_URL_HERE

# JWT
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=7d

# Firebase Admin SDK
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# App
PORT=3001
API_PREFIX=api/v1/user
API_DOCS_PATH=api/docs/user
CORS_ORIGINS=*
# Railway S3-compatible storage
RAILWAY_STORAGE_ENDPOINT=https://t3.storageapi.dev
RAILWAY_STORAGE_BUCKET=modular-briefcase-3zqsvdp
RAILWAY_STORAGE_ACCESS_KEY_ID=replace-with-railway-access-key-id
RAILWAY_STORAGE_SECRET_ACCESS_KEY=replace-with-railway-secret-access-key
RAILWAY_STORAGE_REGION=auto
# Optional public base URL override
# STORAGE_PUBLIC_URL=https://t3.storageapi.dev/modular-briefcase-3zqsvdp
